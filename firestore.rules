rules_version = '2';

// Households: each household has its own board, and only its members can open it.
//
//   households/{id}           name, members { email: 'owner' | 'editor' | 'viewer' }, memberEmails [email]
//   households/{id}/board/*   schedule, checked, rules, todos, meals
//
// Owners manage the household (members and roles). Editors can change the board.
// Viewers can only look. Emails are lower-case Google account addresses.
//
// Creating a new household is limited to accounts listed in "creators" (add a document
// whose ID is their email). The original two-person "members" list still works during
// the move to households: those accounts can read the old board, create the
// "home" household from it, and add themselves to it as owners.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    function legacyMember() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.token.email));
    }
    function creator() {
      return signedIn() && exists(/databases/$(database)/documents/creators/$(request.auth.token.email));
    }
    function roleIn(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data.members.get(email(), null);
    }
    // memberEmails must always list exactly the keys of members (it lets the app find your households).
    function membersConsistent() {
      return request.resource.data.memberEmails.toSet() == request.resource.data.members.keys().toSet();
    }
    // Households are named by the people in them: 1 to 40 characters.
    function validName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40;
    }

    match /households/{hid} {
      allow read: if signedIn() && (email() in resource.data.memberEmails
                                    || (legacyMember() && hid == 'home'));

      allow create: if (creator() || (legacyMember() && hid == 'home'))
                    && request.resource.data.members[email()] == 'owner'
                    && membersConsistent() && validName();

      // Owners can change anything about their household.
      allow update: if signedIn() && resource.data.members.get(email(), null) == 'owner'
                    && membersConsistent() && validName();

      // One-time join for the original two members: add yourself to home as an owner.
      allow update: if legacyMember() && hid == 'home'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberEmails'])
                    && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([email()])
                    && request.resource.data.members[email()] == 'owner'
                    && membersConsistent();

      allow delete: if signedIn() && resource.data.members.get(email(), null) == 'owner';

      match /board/{docId} {
        allow read: if signedIn() && roleIn(hid) != null;
        allow write: if signedIn() && roleIn(hid) in ['owner', 'editor'];
      }
    }

    // The original shared board, from before households. Kept working until everyone's
    // phone has picked up the household version; the app copies it into home.
    match /board/{docId} {
      allow read, write: if legacyMember();
    }

    match /members/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }
    match /creators/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
    }
  }
}
